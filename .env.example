APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Anime streaming resolver (self-hosted or public Anivexa API).
# Local dev: clone https://github.com/walterwhite-69/Anivexa-API, run `node server.js`.
# Use 127.0.0.1 rather than localhost: the IPv6 fallback made requests 4x slower
# (10.9s vs 2.5s measured on Windows). A localhost URL is ignored in production.
# When unset, the app uses the public instance that ships with BiblioCore.
# ANIME_API_URL=http://127.0.0.1:4000
# Multiple bases may be comma-separated; they are tried in order until one answers.
# ANIME_API_URL=https://anivexa-api-nine.vercel.app
# ANIME_API_KEY= (shared secret sent as x-api-key header; required by keyed instances)

# Secondary anime source: Anikoto (MegaPlay library) keyed by AniList id.
# It has no search route, so a small index of the most recent 100-title pages
# is built and cached for 12 hours. 12 pages ≈ 1.200 currently airing titles.
# ANIKOTO_API_URL=https://anikotoapi.site
# ANIKOTO_INDEX_PAGES=12

# HiAnime shut down in 2026; the old public wrapper answers 503. Leave this
# empty unless you self-host an AniWatch-compatible instance.
# HIANIME_API_URL=
# CONSUMET_BASE_URL=

# English manga chapters from Atsumaru's public JSON API.
# ATSUMARU_API_URL=https://atsu.moe

# Hard-subtitled anime: one MP4 per episode with the text burned in.
# AnimeHeaven (English, sub only) and Nimegami + Samehadaku (Indonesian).
# Offered in the player's Mode picker and via ?server=animeheaven,
# ?server=id, ?server=nimegami or ?server=samehadaku on the stream endpoint.
# ANIMEHEAVEN_URL=https://animeheaven.me
# NIMEGAMI_URL=https://nimegami.id
# SAMEHADAKU_URL=https://v2.samehadaku.how

# 9Router: OpenAI-compatible AI gateway (one key, many models).
# Local default is http://127.0.0.1:20128; on Vercel use a public tunnel/VPS.
# Used as a fallback subtitle translator when the free endpoint fails.
# NINEROUTER_URL=http://127.0.0.1:20128
# NINEROUTER_KEY=sk-...
# NINEROUTER_MODEL=ag/gemini-4-hydrogen-high
# NINEROUTER_TIMEOUT=25
# NINEROUTER_TRANSLATION=false   # opt out of AI subtitle translation
# NINEROUTER_TRANSLATION_MODEL=ag/gemini-4-hydrogen-high

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
